# Supabaseプロジェクト設定
# Supabaseダッシュボード → Project Settings → API から取得できます
# このファイルをコピーして .env.local を作成し、実際の値を入力してください
#   cp .env.local.example .env.local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API設定(AI出題・作文添削等で使用。サーバー側のみで参照するため
# NEXT_PUBLIC_を付けない。Anthropic Consoleから取得できます)
ANTHROPIC_API_KEY=
